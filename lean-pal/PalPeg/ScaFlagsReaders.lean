/-- The certificate, decoded to head names. -/
def readerCert : Array (List String) :=
  (readerCertN.map fun l => l.map fun i => fspec.names.getD i "").toArray

/-! ## The checks -/

/-- Row `r`: the certificate is a post-fixpoint of `readerTransfer`, the colouring is proper on
the after-set, the live heads are coloured. -/
def rowOk (r : Nat) (row : Row) : Bool :=
  let before := readerCert.getD r []
  let after := successorsUnion readerCert row.targets
  let cs := after.map fun h => (h, color fspec h)
  (readerTransfer row after).all (fun x => decide (x ∈ before)) &&
  cs.all (fun c => cs.all fun c' => decide (c.1 = c'.1) || c.2.isNone || decide (c.2 ≠ c'.2)) &&
  before.all (fun h => (color fspec h).isSome)

/-- `rowOk` on the rows `lo, …, lo + n - 1`. -/
def rowsOk (lo n : Nat) : Bool :=
  (List.range' lo n).all fun r =>
    match fspec.program.code[r]? with
    | some row => rowOk r row
    | none => true

theorem rowsOk_append (lo a b : Nat) :
    rowsOk lo (a + b) = (rowsOk lo a && rowsOk (lo + a) b) := by
  unfold rowsOk
  rw [← List.all_append]
  congr 1
  simp

theorem rowsOk_split (lo a b : Nat) (hfirst : rowsOk lo a = true)
    (hrest : rowsOk (lo + a) b = true) : rowsOk lo (a + b) = true := by
  rw [rowsOk_append, hfirst, hrest]
  rfl

set_option maxRecDepth 100000

theorem rows_0 : rowsOk 0 100 = true := by decide +kernel

theorem rows_100 : rowsOk 100 100 = true := by decide +kernel

theorem rows_200 : rowsOk 200 100 = true := by decide +kernel

theorem rows_300 : rowsOk 300 100 = true := by decide +kernel

theorem rows_400 : rowsOk 400 92 = true := by decide +kernel

theorem rows_ok : rowsOk 0 fspec.program.code.length = true := by
  rw [ScaWorkerRegs.flags_code_length]
  exact rowsOk_split 0 100 392 rows_0
    (rowsOk_split 100 100 292 rows_100
    (rowsOk_split 200 100 192 rows_200
    (rowsOk_split 300 100 92 rows_300 rows_400)))

/-- Every certificate entry has at most `7` heads. -/
theorem lengths_ok : readerCertN.all (fun l => decide (l.length ≤ 7)) = true := by decide +kernel

/-- At the start row only `Origin`, `TextOrigin`, `OriginalEnd` are in the certificate. -/
theorem start_ok :
    (readerCert.getD fspec.program.start []).all
      (fun h => decide (h = "Origin" ∨ h = "TextOrigin" ∨ h = "OriginalEnd")) = true := by
  decide +kernel

/-! ## `readerTransfer` is monotone and duplicate-free -/

theorem transfer_mono (row : Row) (xs ys : List String) (hsub : xs ⊆ ys) :
    readerTransfer row xs ⊆ readerTransfer row ys := by
  obtain ⟨ev, targets⟩ := row
  intro x hx
  cases ev with
  | copy t src =>
    change x ∈ (if t ∈ xs then union (xs.filter fun y => decide (y ≠ t)) [src] else xs) at hx
    change x ∈ (if t ∈ ys then union (ys.filter fun y => decide (y ≠ t)) [src] else ys)
    by_cases htx : t ∈ xs
    · have hty : t ∈ ys := hsub htx
      rw [if_pos htx, ScaWorkerRegs.mem_union] at hx
      rw [if_pos hty, ScaWorkerRegs.mem_union]
      rcases hx with hx | hx
      · rw [List.mem_filter] at hx
        exact Or.inl (List.mem_filter.mpr ⟨hsub hx.1, hx.2⟩)
      · exact Or.inr hx
    · rw [if_neg htx] at hx
      by_cases hty : t ∈ ys
      · rw [if_pos hty, ScaWorkerRegs.mem_union]
        refine Or.inl (List.mem_filter.mpr ⟨hsub hx, ?_⟩)
        simp only [ne_eq, decide_eq_true_eq]
        rintro rfl
        exact htx hx
      · rw [if_neg hty]
        exact hsub hx
  | symbols l r =>
    change x ∈ union xs [l, r] at hx
    change x ∈ union ys [l, r]
    rw [ScaWorkerRegs.mem_union] at hx ⊢
    rcases hx with hx | hx
    · exact Or.inl (hsub hx)
    · exact Or.inr hx
  | available h =>
    change x ∈ union xs [h] at hx
    change x ∈ union ys [h]
    rw [ScaWorkerRegs.mem_union] at hx ⊢
    rcases hx with hx | hx
    · exact Or.inl (hsub hx)
    · exact Or.inr hx
  | move ms => exact hsub hx
  | equal a b => exact hsub hx
  | less a b => exact hsub hx
  | border h => exact hsub hx
  | flag b => exact hsub hx
  | assertEqual a b => exact hsub hx
  | «match» h => exact hsub hx
  | halt => exact hsub hx

theorem transfer_nodup (row : Row) (xs : List String) (hxs : xs.Nodup) :
    (readerTransfer row xs).Nodup := by
  obtain ⟨ev, targets⟩ := row
  cases ev with
  | copy t src =>
    change (if t ∈ xs then union (xs.filter fun y => decide (y ≠ t)) [src] else xs).Nodup
    split
    · exact ScaWorkerRegs.union_nodup _ _ (hxs.filter _)
    · exact hxs
  | symbols l r => exact ScaWorkerRegs.union_nodup xs [l, r] hxs
  | available h => exact ScaWorkerRegs.union_nodup xs [h] hxs
  | move ms => exact hxs
  | equal a b => exact hxs
  | less a b => exact hxs
  | border h => exact hxs
  | flag b => exact hxs
  | assertEqual a b => exact hxs
  | «match» h => exact hxs
  | halt => exact hxs

/-! ## The certificate is a small post-fixpoint -/

theorem rowOk_of_code {r : Nat} {row : Row} (hrow : fspec.program.code[r]? = some row) :
    rowOk r row = true := by
  have hlt : r < fspec.program.code.length := (List.getElem?_eq_some_iff.mp hrow).1
  have hall := List.all_eq_true.mp rows_ok r (List.mem_range'_1.mpr ⟨Nat.zero_le _, by omega⟩)
  rw [hrow] at hall
  exact hall

/-- `rowOk`, unpacked. -/
theorem rowOk_spec {r : Nat} {row : Row} (hok : rowOk r row = true) :
    (∀ x ∈ readerTransfer row (successorsUnion readerCert row.targets),
      x ∈ readerCert.getD r []) ∧
    Proper fspec (successorsUnion readerCert row.targets) ∧
    Colored fspec (readerCert.getD r []) := by
  simp only [rowOk, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨hfix, hproper⟩, hcolored⟩ := hok
  refine ⟨hfix, ?_, ?_⟩
  · intro h hA h' hA' i hc hc'
    have hpair := hproper (h, color fspec h) (List.mem_map.mpr ⟨h, hA, rfl⟩)
      (h', color fspec h') (List.mem_map.mpr ⟨h', hA', rfl⟩)
    rw [hc, hc'] at hpair
    simpa using hpair
  · intro h hh
    have hsome := hcolored h hh
    obtain ⟨i, hi⟩ := Option.isSome_iff_exists.mp hsome
    exact ⟨i, hi⟩

theorem postFix : ScaWorkerRegs.PostFix fspec.program.code readerTransfer readerCert :=
  fun _ _ hrow => (rowOk_spec (rowOk_of_code hrow)).1

theorem getD_length_le (r : Nat) : (readerCert.getD r []).length ≤ 7 := by
  have hall := List.all_eq_true.mp lengths_ok
  unfold readerCert
  rw [Array.getD_eq_getD_getElem?, List.getElem?_toArray]
  cases hget : (readerCertN.map fun l => l.map fun i => fspec.names.getD i "")[r]? with
  | none => simp
  | some l =>
    rw [List.getElem?_map] at hget
    cases hl : readerCertN[r]? with
    | none => rw [hl] at hget; cases hget
    | some l0 =>
      rw [hl] at hget
      cases hget
      have h7 := hall l0 (List.mem_of_getElem? hl)
      simp only [decide_eq_true_eq] at h7
      simpa using h7

theorem weight_lt :
    ScaWorkerRegs.weight fspec.program.code readerCert <
      fspec.program.code.length * fspec.names.length + 1 := by
  have hle : ScaWorkerRegs.weight fspec.program.code readerCert ≤
      ∑ _r ∈ Finset.range fspec.program.code.length, 7 :=
    Finset.sum_le_sum fun r _ => getD_length_le r
  rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at hle
  have hnames : fspec.names.length = 18 := rfl
  rw [hnames]
  omega

/-- **`liveReaders` against the certificate**: below it row by row, and a post-fixpoint. -/
theorem liveReaders_spec :
    ScaWorkerRegs.Approx fspec.program.code readerTransfer readerCert (liveReaders fspec) ∧
      ScaWorkerRegs.PostFix fspec.program.code readerTransfer (liveReaders fspec) :=
  ScaWorkerRegs.fixpoint_spec transfer_mono transfer_nodup postFix weight_lt

/-! ## The reader facts -/

theorem live_sub_cert (r : Nat) : ∀ h ∈ live r, h ∈ readerCert.getD r [] :=
  fun _ hh => liveReaders_spec.1.below r hh

/-- **The reader facts of the flag table**, for every row. -/
theorem readerFacts : ReaderFacts where
  fix := fun _ _ r row _ hrow _ hx => liveReaders_spec.2 r row hrow hx
  proper := fun _ _ _ row _ hrow h hA h' hA' i hc hc' =>
    (rowOk_spec (rowOk_of_code hrow)).2.1 h
      (ScaWorkerRegs.successorsUnion_mono liveReaders_spec.1.below row.targets hA) h'
      (ScaWorkerRegs.successorsUnion_mono liveReaders_spec.1.below row.targets hA') i hc hc'
  colored := fun _ _ r hsim h hh => by
    obtain ⟨row, hrow, -⟩ := ScaGsCert.sim_step ScaGsCertData.flags_certOk hsim
    exact (rowOk_spec (rowOk_of_code hrow)).2.2 h (live_sub_cert r h hh)
  startLive := fun h hh => by
    have hmem := live_sub_cert fspec.program.start h hh
    have hall := List.all_eq_true.mp start_ok h hmem
    simpa using hall

end PalPeg.ScaFlagsReaders
