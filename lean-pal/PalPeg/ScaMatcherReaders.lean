/-- The matcher certificate, decoded to head names. -/
def matcherReaders : Array (List String) :=
  decode ScaGsTables.matcherWorker matcherReadersN

/-- Paths from the two `match` rows to rows reading `B` (`available "B"` at 46 and 151). -/
def matchPaths : List (Nat × List Nat) :=
  [(84, [54, 59, 35, 41, 46]), (203, [163, 171, 179, 137, 144, 151])]

set_option maxRecDepth 100000

theorem rows_0 : rowsOk ScaGsTables.matcherWorker matcherReaders 0 100 = true := by
  decide +kernel

theorem rows_100 : rowsOk ScaGsTables.matcherWorker matcherReaders 100 100 = true := by
  decide +kernel

theorem rows_200 : rowsOk ScaGsTables.matcherWorker matcherReaders 200 94 = true := by
  decide +kernel

theorem rows_ok :
    rowsOk ScaGsTables.matcherWorker matcherReaders 0
      ScaGsTables.matcherWorker.program.code.length = true := by
  rw [ScaWorkerRegs.matcher_code_length]
  exact rowsOk_split 0 100 194 rows_0 (rowsOk_split 100 100 94 rows_100 rows_200)

theorem entries_ok : entriesOk ScaGsTables.matcherWorker matcherReadersN 6 = true := by
  decide +kernel

theorem start_ok :
    (matcherReaders.getD ScaGsTables.matcherWorker.program.start []).all
      (fun h => decide (h = "Origin" ∨ h = "Tail")) = true := by
  decide +kernel

theorem match_ok : matchOk ScaGsTables.matcherWorker matchPaths = true := by
  decide +kernel

/-- The real `liveReaders` of the matcher: below the certificate, and a post-fixpoint. -/
theorem liveReaders_spec :
    ScaWorkerRegs.Approx ScaGsTables.matcherWorker.program.code readerTransfer matcherReaders
        (liveReaders ScaGsTables.matcherWorker) ∧
      ScaWorkerRegs.PostFix ScaGsTables.matcherWorker.program.code readerTransfer
        (liveReaders ScaGsTables.matcherWorker) :=
  liveReaders_spec_of_cert rows_ok entries_ok (by decide)

/-! ## The five reader facts of the matcher -/

/-- `liveReaders` is a post-fixpoint of `readerTransfer` at every row. -/
theorem fix : ∀ (r : Nat) (row : Row), ScaGsTables.matcherWorker.program.code[r]? = some row →
    ∀ x ∈ readerTransfer row
        (successorsUnion (liveReaders ScaGsTables.matcherWorker) row.targets),
      x ∈ (liveReaders ScaGsTables.matcherWorker).getD r [] :=
  fun r row hrow _ hx => liveReaders_spec.2 r row hrow hx

/-- The reader colouring is proper on the readers live after every row. -/
theorem proper : ∀ (r : Nat) (row : Row), ScaGsTables.matcherWorker.program.code[r]? = some row →
    Proper ScaGsTables.matcherWorker
      (successorsUnion (liveReaders ScaGsTables.matcherWorker) row.targets) :=
  fun _ row hrow h hA h' hA' i hc hc' =>
    (rowOk_spec (rowOk_of_rows rows_ok hrow)).2 h
      (ScaWorkerRegs.successorsUnion_mono liveReaders_spec.1.below row.targets hA) h'
      (ScaWorkerRegs.successorsUnion_mono liveReaders_spec.1.below row.targets hA') i hc hc'

/-- Every live reader has a register, at every row index. -/
theorem colored : ∀ r : Nat, Colored ScaGsTables.matcherWorker
    ((liveReaders ScaGsTables.matcherWorker).getD r []) :=
  fun r h hh => (entries_spec entries_ok r).2 h (liveReaders_spec.1.below r hh)

/-- At the start row only `Origin` and `Tail` are live. -/
theorem startLive : ∀ h ∈ (liveReaders ScaGsTables.matcherWorker).getD
    ScaGsTables.matcherWorker.program.start [], h = "Origin" ∨ h = "Tail" := by
  intro h hh
  have hall := List.all_eq_true.mp start_ok h (liveReaders_spec.1.below _ hh)
  simpa using hall

/-- `B` is live at every `match` row. -/
theorem matchB : ∀ (r : Nat) (row : Row), ScaGsTables.matcherWorker.program.code[r]? = some row →
    ∀ h, row.event = .«match» h → "B" ∈ (liveReaders ScaGsTables.matcherWorker).getD r [] :=
  matchB_of_check liveReaders_spec.2 match_ok

end PalPeg.ScaMatcherReaders
