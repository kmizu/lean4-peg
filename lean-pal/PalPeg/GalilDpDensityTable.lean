private theorem rows_352 : ∀ q : Fin 21,
    (GalilDpCode.code[q.val+352]?).map (row (q.val+352)) = some true := by decide

theorem rows : ∀ q : Fin 373,
    (GalilDpCode.code[q.val]?).map (row q.val) = some true := by
  intro q

  by_cases h0 : q.val < 32

  · have h := rows_0 ⟨q.val-0,by omega⟩

    simpa only [Nat.sub_add_cancel (show 0 ≤ q.val by omega)] using h

  by_cases h32 : q.val < 64

  · have h := rows_32 ⟨q.val-32,by omega⟩

    simpa only [Nat.sub_add_cancel (show 32 ≤ q.val by omega)] using h

  by_cases h64 : q.val < 96

  · have h := rows_64 ⟨q.val-64,by omega⟩

    simpa only [Nat.sub_add_cancel (show 64 ≤ q.val by omega)] using h

  by_cases h96 : q.val < 128

  · have h := rows_96 ⟨q.val-96,by omega⟩

    simpa only [Nat.sub_add_cancel (show 96 ≤ q.val by omega)] using h

  by_cases h128 : q.val < 160

  · have h := rows_128 ⟨q.val-128,by omega⟩

    simpa only [Nat.sub_add_cancel (show 128 ≤ q.val by omega)] using h

  by_cases h160 : q.val < 192

  · have h := rows_160 ⟨q.val-160,by omega⟩

    simpa only [Nat.sub_add_cancel (show 160 ≤ q.val by omega)] using h

  by_cases h192 : q.val < 224

  · have h := rows_192 ⟨q.val-192,by omega⟩

    simpa only [Nat.sub_add_cancel (show 192 ≤ q.val by omega)] using h

  by_cases h224 : q.val < 256

  · have h := rows_224 ⟨q.val-224,by omega⟩

    simpa only [Nat.sub_add_cancel (show 224 ≤ q.val by omega)] using h

  by_cases h256 : q.val < 288

  · have h := rows_256 ⟨q.val-256,by omega⟩

    simpa only [Nat.sub_add_cancel (show 256 ≤ q.val by omega)] using h

  by_cases h288 : q.val < 320

  · have h := rows_288 ⟨q.val-288,by omega⟩

    simpa only [Nat.sub_add_cancel (show 288 ≤ q.val by omega)] using h

  by_cases h320 : q.val < 352

  · have h := rows_320 ⟨q.val-320,by omega⟩

    simpa only [Nat.sub_add_cancel (show 320 ≤ q.val by omega)] using h

  have h := rows_352 ⟨q.val-352,by omega⟩
  simpa only [Nat.sub_add_cancel (show 352 ≤ q.val by omega)] using h

theorem lookup {q : ℕ} {i : Instruction 12} (hi : GalilDpCode.code[q]? = some i)
    (t : Fin 12) (b : Band) (hb : allowed q t b = true) :
    safe q i t b = true ∧ ∀ v ∈ transfers i t b, allowed v.1 t v.2 = true := by
  have hq : q < 373 := (List.getElem?_eq_some_iff.mp hi).1
  have h := rows ⟨q,hq⟩
  simp only [hi,Option.map_some,Option.some.injEq,row] at h
  have ht := List.all_eq_true.mp h t (List.mem_finRange t)
  have hd := List.all_eq_true.mp ht b (List.mem_finRange b)
  simpa only [hb,Bool.not_true,Bool.false_or,Bool.and_eq_true,List.all_eq_true] using hd

/-- info: 'PalPeg.GalilDpDensityTable.rows' depends on axioms: [propext, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms rows

end PalPeg.GalilDpDensityTable
